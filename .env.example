# Copy to .env for local development, or set these in Railway → Variables.
# All values below are PUBLIC (safe in the browser). Never put the Supabase
# service_role key here or in any VITE_* variable.

# Supabase project (Settings → API in the Supabase dashboard)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Same values for server-side rendering (read at runtime)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Google sign-in: "supabase" (own Google provider) or "lovable" (Lovable broker)
VITE_AUTH_MODE=supabase

# Public URL of the deployed site (used for absolute links in /sitemap.xml)
PUBLIC_SITE_URL=https://your-app.up.railway.app
